{
  "name": "llm-optimized-search",
  "version": "0.1.0",
  "description": "CLI that forces specialized LLM-native search tools (Grok x_search, Gemini google_search, Grok web_search) — optimized for AI agents",
  "type": "module",
  "bin": {
    "llms": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node ./dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@google/genai": "^2.0.1",
    "cac": "^6.7.14",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
