{
  "name": "x-search-tool",
  "version": "0.2.0",
  "description": "X-first search CLI — forces Grok's x_search (with web_search fallback) and returns cited JSON. Optimized for AI agents.",
  "type": "module",
  "bin": {
    "x-search": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node ./dist/cli.js",
    "test": "npm run build && tsx --test test/index.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
